page {
  background: #f6f7f9;
}

.page {
  padding: 28rpx;
}

.search-row {
  display: flex;
  gap: 20rpx;
}

.search-row input {
  flex: 2;
  background: #fff;
  padding: 0 20rpx;
  height: 78rpx;
  border-radius: 10rpx;
}

.search-row button {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 24rpx;
  background: #07c160;
  color: #fff;
}

.filters button {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
}

.filters {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 0;
}

.filters button {
  flex: 1;
  background: #fff;
  font-size: 24rpx;
  color: #374151;
}

.filters button.active {
  background: #07c160;
  color: #fff;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 15rpx;
}

.action-row button {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 10rpx;
}

.primary-button {
  background: #07c160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.secondary-button {
  background: #1989fa;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-card {
  background: #fff;
  padding: 26rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  position: relative;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.price {
  color: #e11d48;
  font-size: 32rpx;
  margin-top: 14rpx;
}

.status {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: #07c160;
  font-size: 24rpx;
}