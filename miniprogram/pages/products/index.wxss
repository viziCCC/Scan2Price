page { background:#f6f7f9; }.page { padding:28rpx; }.search-row { display:flex; gap:12rpx; }.search-row input { flex:1; background:#fff; padding:0 20rpx; height:78rpx; border-radius:10rpx; }.search-row button,.filters button { height:78rpx; line-height:78rpx; padding:0 24rpx; }.filters { display:flex; gap:12rpx; margin:20rpx 0; }.filters button { flex:1; background:#fff; font-size:24rpx; }.primary-button,.secondary-button { height:84rpx; line-height:84rpx; margin-top:14rpx; border-radius:10rpx; }.primary-button { background:#07c160; color:#fff; }.item-card { background:#fff; padding:26rpx; margin-top:18rpx; border-radius:12rpx; position:relative; }.name { font-size:32rpx; font-weight:600; }.muted { color:#6b7280; font-size:24rpx; margin-top:8rpx; }.price { color:#e11d48; font-size:32rpx; margin-top:14rpx; }.status { position:absolute; right:24rpx; top:24rpx; color:#07c160; font-size:24rpx; }
