page {
  background: #f6f7f9;
}

.page {
  padding: 48rpx 32rpx calc(48px + env(safe-area-inset-bottom) + 32rpx);
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 600;
  color: #1f2937;
}

.subtitle {
  color: #6b7280;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.id-box {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.id-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, monospace;
  font-size: 26rpx;
  color: #374151;
  word-break: break-all;
  line-height: 1.6;
}

.copy-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.copy-btn.copied {
  background: #059669;
}

.copy-btn[disabled] {
  background: #d1d5db;
}

.tips-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 24rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tips-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tips-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #07c160;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.tips-item text:last-child {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 32rpx;
  background: #fff;
  border: 1rpx solid #d1d5db;
  color: #6b7280;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

.share-btn::after {
  display: none;
}

.share-icon {
  font-size: 32rpx;
}