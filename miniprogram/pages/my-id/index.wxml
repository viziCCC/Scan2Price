<view class="page">
  <view class="header">
    <view class="title">我的用户ID</view>
    <view class="subtitle">用于管理员授权</view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">用户ID（OpenID）</text>
      <text class="card-desc">这是您在小程序中的唯一标识</text>
    </view>

    <view class="id-box">
      <text class="id-text" selectable>{{loading ? '获取中...' : openid}}</text>
    </view>

    <button
      class="copy-btn {{copied ? 'copied' : ''}}"
      bindtap="copyOpenId"
      disabled="{{loading || !openid}}"
    >
      {{copied ? '已复制' : '复制用户ID'}}
    </button>
  </view>

  <view class="tips-card">
    <view class="tips-title">如何获取管理员权限？</view>
    <view class="tips-list">
      <view class="tips-item">
        <text class="tips-num">1</text>
        <text>点击上方"复制用户ID"按钮</text>
      </view>
      <view class="tips-item">
        <text class="tips-num">2</text>
        <text>将用户ID发送给现任管理员</text>
      </view>
      <view class="tips-item">
        <text class="tips-num">3</text>
        <text>管理员会将您添加到管理员列表</text>
      </view>
    </view>
  </view>
</view>