page {
  background: #f6f7f9;
}

.page {
  padding: 48rpx 32rpx 160rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-row .link-button {
  height: 60rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
  width: 220rpx;
  margin-top: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 52rpx;
  font-weight: 600;
  color: #1f2937;
}

.subtitle,
.muted {
  color: #6b7280;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.link-button {
  margin: 0;
  padding: 0 18rpx;
  font-size: 28rpx;
  background: #07c160;
  color: #fff;
}

.scan-button {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  line-height: 112rpx;
  font-size: 34rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.primary-button {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}

.secondary-button {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
}

.manual-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.barcode-input {
  flex: 1;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.manual-row button {
  width: 150rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

.product-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 32rpx;
}

.product-name-row {
  color: #111827;
  font-size: 36rpx;
  font-weight: 600;
}

.product-name {
  color: #111827;
}

.product-spec {
  color: #6b7280;
}

.price {
  color: #e11d48;
  font-size: 56rpx;
  font-weight: 700;
  margin: 24rpx 0;
}

.product-card button {
  height: 88rpx;
  line-height: 88rpx;
}

.cart-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  background: #1989fa;
  text-align: center;
  border-radius: 12rpx;
  padding: 28rpx;
  color: #fff;
}

.cart-entry text {
  font-size: 40rpx;
  margin-left: 16rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
}

.success-tip {
  color: #07c160;
  font-size: 28rpx;
  text-align: center;
  padding: 16rpx 0 0;
}