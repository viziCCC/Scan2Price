page {
  background: #f6f7f9;
}

.page {
  padding: 30rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field text {
  display: block;
  color: #374151;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.field input,
.field textarea {
  box-sizing: border-box;
  width: 100%;
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  min-height: 78rpx;
}

.inline {
  display: flex;
  gap: 12rpx;
}

.inline input {
  flex: 1;
}

.inline button {
  width: 140rpx;
}

.primary,
.status {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
}

.primary {
  background: #07c160;
  color: #fff;
}

.status {
  background: #fff;
  color: #ef4444;
}