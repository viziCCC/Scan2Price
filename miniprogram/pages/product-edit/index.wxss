page {
  background: #f6f7f9;
}

.page {
  padding: 30rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field text {
  display: block;
  color: #374151;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.field input,
.field textarea {
  box-sizing: border-box;
  width: 100%;
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  min-height: 78rpx;
}

.input-wrap {
  position: relative;
}

.input-wrap input {
  padding-right: 56rpx;
}

.input-wrap .clear-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #c0c4cc;
  color: #fff;
  font-size: 28rpx;
}

.inline {
  display: flex;
  gap: 12rpx;
}

.inline input {
  flex: 1;
}

.inline button {
  width: 140rpx;
}

.primary,
.status {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
}

.primary {
  background: #07c160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status {
  background: #fff;
  color: #ef4444;
}