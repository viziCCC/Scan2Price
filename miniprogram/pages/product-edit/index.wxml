<view class="page"><view class="field"><text>条形码</text><view class="inline"><input value="{{form.barcode}}" data-field="barcode" bindinput="input"/><button bindtap="scan">扫码</button></view></view><view class="field"><text>商品名称</text><input value="{{form.name}}" data-field="name" bindinput="input" placeholder="必填"/></view><view class="field"><text>价格（元）</text><input type="digit" value="{{form.price}}" data-field="price" bindinput="input" placeholder="例如 3.50"/></view><view class="field"><text>规格</text><input value="{{form.specification}}" data-field="specification" bindinput="input"/></view><view class="field"><text>单位</text><input value="{{form.unit}}" data-field="unit" bindinput="input"/></view><view class="field"><text>备注</text><textarea value="{{form.remark}}" data-field="remark" bindinput="input"/></view><button class="primary" bindtap="submit">保存商品</button><button wx:if="{{editing}}" class="status" bindtap="changeStatus">{{form.status === 'on_sale' ? '下架商品' : '上架商品'}}</button></view>
