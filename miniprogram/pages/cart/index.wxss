page {
  background: #f6f7f9;
}

.page {
  padding: 32rpx 28rpx 220rpx;
}

.primary-button {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}

.scan-button {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.item-name-row {
  font-size: 32rpx;
  font-weight: 600;
}

.item-name {
  color: #111827;
}

.item-spec {
  color: #6b7280;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.item-subtotal {
  text-align: right;
  color: #e11d48;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: -36rpx;
}

.quantity-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 30rpx;
}

.quantity-row button {
  min-width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  background: #f3f4f6;
  border-radius: 8rpx;
}

.quantity-row text {
  min-width: 42rpx;
  text-align: center;
}

.quantity-text {
  color: #374151;
}

.quantity-input {
  min-width: 80rpx;
  height: 64rpx;
  text-align: center;
  background: #fff3cd;
  border-radius: 8rpx;
  border: 1rpx solid #f59e0b;
}

.quantity-row .remove {
  margin-left: auto;
  min-width: 100rpx;
  color: #ef4444;
  background: #fff;
  font-size: 24rpx;
}

.summary {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.total {
  color: #e11d48;
  font-size: 38rpx;
  font-weight: 700;
}

.clear {
  margin-left: auto;
  color: #ef4444;
  background: #fff;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 160rpx 0;
}