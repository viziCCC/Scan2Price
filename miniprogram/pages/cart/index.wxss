page {
  background: #f6f7f9;
}

.page {
  padding: 32rpx 28rpx calc(280rpx + env(safe-area-inset-bottom));
}

.primary-button {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}

.scan-button {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.item-name-row {
  font-size: 32rpx;
  font-weight: 600;
}

.item-name {
  color: #111827;
}

.item-spec {
  color: #6b7280;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.item-subtotal {
  text-align: right;
  color: #e11d48;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: -36rpx;
}

.quantity-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 30rpx;
}

.quantity-row button {
  min-width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  background: #f3f4f6;
  border-radius: 8rpx;
}

.quantity-row text {
  min-width: 42rpx;
  text-align: center;
}

.quantity-text {
  color: #374151;
}

.quantity-input {
  min-width: 80rpx;
  height: 64rpx;
  text-align: center;
  background: #fff3cd;
  border-radius: 8rpx;
  border: 1rpx solid #f59e0b;
}

.quantity-row .remove {
  margin-left: auto;
  min-width: 100rpx;
  color: #ef4444;
  background: #fff;
  font-size: 24rpx;
}

.summary {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(48px + env(safe-area-inset-bottom));
  background: #fff;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.total {
  color: #e11d48;
  font-size: 38rpx;
  font-weight: 700;
}

.clear {
  margin-left: auto;
  color: #ef4444;
  background: #fff;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 160rpx 0;
}

/* 计算器 */
.calc-btn {
  color: #1989fa;
  background: #fff;
  font-size: 24rpx;
}

.calculator-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.calculator-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + 48px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.calculator-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.calculator-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.calculator-close {
  font-size: 48rpx;
  color: #9ca3af;
  line-height: 1;
  padding: 0 12rpx;
}

.calc-display {
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.calc-expression {
  font-size: 26rpx;
  color: #6b7280;
  min-height: 32rpx;
  text-align: right;
}

.calc-result {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  text-align: right;
  margin-top: 8rpx;
  word-break: break-all;
}

.calc-keypad {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.calc-row {
  display: flex;
  gap: 16rpx;
}

.calc-key {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #111827;
}

.calc-key.operator {
  background: #e5e7eb;
  color: #1989fa;
  font-weight: 600;
}

.calc-key.clear {
  color: #ef4444;
}

.calc-key.equal {
  flex: 1;
  background: #1989fa;
  color: #fff;
  font-weight: 700;
}

.calc-key.zero {
  flex: 2;
}

.calc-key.base-btn {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
}

.calc-key:active {
  opacity: 0.7;
}